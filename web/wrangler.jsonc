// Cloudflare Worker: prerendered Angular pages as static assets + the /api/* request handler (worker/index.ts).
// Build first: `npm run build` (preview) or `npm run build:production`. Local: `npx wrangler dev`.
// Secrets are never stored here: wrangler secret put RESEND_API_KEY | RESEND_FROM_EMAIL | RESEND_TO_EMAIL |
// TURNSTILE_SECRET_KEY | FORM_SECRET (locally: .dev.vars, git-ignored).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "liudmyla-petruk-notary",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist/site/browser",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "durable_objects": { "bindings": [{ "name": "BOOKING_STORE", "class_name": "BookingStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BookingStore"] }],
  "ratelimits": [{ "name": "BOOKING_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "vars": { "SITE_ENV": "preview", "LDA_PUBLISHED": "true" },
  "observability": { "enabled": true },
  "env": {
    "production": {
      "name": "liudmyla-petruk-notary-production",
      "durable_objects": { "bindings": [{ "name": "BOOKING_STORE", "class_name": "BookingStore" }] },
      "ratelimits": [{ "name": "BOOKING_LIMIT", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }],
      "vars": { "SITE_ENV": "production", "LDA_PUBLISHED": "false" }
    }
  }
}
