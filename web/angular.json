{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "site": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "lp",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.css"
            ],
            "server": "src/main.server.ts",
            "outputMode": "static",
            "define": {
              "LDA_PUBLISHED": "true",
              "SITE_ENV": "\"preview\"",
              "SITE_URL": "\"https://liudmyla-petruk-notary.workers.dev\"",
              "TURNSTILE_SITE_KEY": "\"\""
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "330kB",
                  "maximumError": "380kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "define": {
                "LDA_PUBLISHED": "false",
                "SITE_ENV": "\"production\"",
                "SITE_URL": "\"https://www.mobilenotary-sacramento.com\"",
                "TURNSTILE_SITE_KEY": "\"\""
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "define": {
                "LDA_PUBLISHED": "true",
                "SITE_ENV": "\"preview\"",
                "SITE_URL": "\"https://liudmyla-petruk-notary.workers.dev\"",
                "TURNSTILE_SITE_KEY": "\"\""
              }
            },
            "preview": {
              "define": {
                "LDA_PUBLISHED": "true",
                "SITE_ENV": "\"preview\"",
                "SITE_URL": "\"https://liudmyla-petruk-notary.workers.dev\"",
                "TURNSTILE_SITE_KEY": "\"\""
              }
            }
          },
          "defaultConfiguration": "production,preview"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "site:build:production"
            },
            "development": {
              "buildTarget": "site:build:development,preview"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
