// Cloudflare Pages: the prerendered Angular pages (dist/site/browser) + Pages Functions for /api/* (functions/, api/).
// Build: `npm run build` (draft) or `npm run build:production`. Local: `npm run dev:pages`. Deploy: see README.
// Secrets are never stored here: Pages project → Settings → Variables and Secrets, or `wrangler pages secret put`
// (RESEND_API_KEY, RESEND_FROM_EMAIL, RESEND_TO_EMAIL, TURNSTILE_SECRET_KEY, FORM_SECRET). Locally: .dev.vars (git-ignored).
//
// The vars below are the API's runtime mode and must match the build: the site is still a draft, so every deployment
// (the production branch included) runs as "preview". At launch set SITE_ENV "production" and LDA_PUBLISHED "false",
// and switch the Pages build command to `npm run build:production`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "liudmyla-petruk-notary",
  "pages_build_output_dir": "./dist/site/browser",
  "compatibility_date": "2026-10-01",
  "vars": { "SITE_ENV": "preview", "LDA_PUBLISHED": "true" }
}
